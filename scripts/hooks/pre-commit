#!/usr/bin/env bash
# Pre-commit quality gates (wired via `git config core.hooksPath scripts/hooks`).
#
# Runs two gates over the files about to be committed, cheapest first:
#   1. eslint-plugin-sonarjs (SonarQube rules) — blocks the commit on any
#      error-level finding in a staged file.
#   2. Codacy local analysis — same gate as the pre-push hook, but scoped to
#      staged files instead of pushed files.
#
# Escape hatches:
#   git commit --no-verify        (standard git override)
#   SONARJS_GATE_OFF=1 git commit (skip the sonarjs gate)
#   CODACY_GATE_OFF=1 git commit  (skip the Codacy gate)
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT" ]] || exit 0
cd "$ROOT" || exit 0

# Only files that could plausibly carry static-analysis findings.
CODE_RE='\.(ts|tsx|js|mjs|cjs|jsx|astro|css|py|rb|go|java|php|sh|vue|svelte)$'
SKIP_RE='^(node_modules/|dist/|dist-server/|\.svelte-kit/|\.codacy/)'

mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR | grep -E "$CODE_RE" | grep -vE "$SKIP_RE")
[[ ${#STAGED[@]} -gt 0 ]] || exit 0

# --- sonarjs gate -------------------------------------------------------------
# S4036: never resolve executables through PATH — the eslint binary is an
# absolute path under the repo's node_modules.
if [[ "${SONARJS_GATE_OFF:-0}" != "1" ]]; then
	ESLINT="$ROOT/node_modules/eslint/bin/eslint.js"
	if [[ ! -f "$ESLINT" ]]; then
		echo "[sonarjs] eslint not installed locally (run npm install); skipping sonarjs gate" >&2
	else
		node "$ESLINT" --no-warn-ignored --config "$ROOT/scripts/eslint.sonarjs.config.mjs" "${STAGED[@]}"
		status=$?
		if [[ $status -eq 1 ]]; then
			echo "[sonarjs] commit blocked by sonarjs findings (fix them, or 'git commit --no-verify' to override)" >&2
			exit 1
		elif [[ $status -ne 0 ]]; then
			# exit 2 = eslint config/tooling failure; a broken tool must never brick commits.
			echo "[sonarjs] eslint run failed (exit $status); allowing commit (tooling error, not a finding)" >&2
		fi
	fi
fi

# --- Codacy gate ---------------------------------------------------------------
if [[ "${CODACY_GATE_OFF:-0}" != "1" ]]; then
	echo "[codacy] analyzing ${#STAGED[@]} staged file(s) ..."
	node "$ROOT/scripts/codacy/pre-push-gate.mjs" "$ROOT" "${STAGED[@]}"
	status=$?
	if [[ $status -ne 0 ]]; then
		echo "[codacy] commit blocked by Codacy gate (fix findings, or 'git commit --no-verify' to override)" >&2
		exit 1
	fi
fi

exit 0
