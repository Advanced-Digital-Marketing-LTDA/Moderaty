#!/usr/bin/env bash
# Codacy pre-push gate (wired via `git config core.hooksPath scripts/hooks`).
#
# Runs Codacy local analysis (including trivy, which runs on pre-push only) on
# the files about to be pushed and blocks pushes that introduce error-level
# (critical/major) findings. Fails closed: a diff that cannot be listed, a
# missing server, or an analysis error also blocks.
# Scoped override (this gate only):
#   CODACY_GATE_OFF=1 git push
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT" ]] || exit 0
[[ "${CODACY_GATE_OFF:-0}" != "1" ]] || exit 0

# shellcheck source=analysis-scope.sh
source "$ROOT/scripts/hooks/analysis-scope.sh"

# git's empty tree: the diff base for a root commit, which has no parent.
EMPTY_TREE="$(git hash-object -t tree /dev/null)"

declare -A FILES=()
declare -A FILE_SHA=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "$local_sha" && "$local_sha" != "0000000000000000000000000000000000000000" ]] || continue
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    # New branch: analyze everything since the parent of the oldest commit that no
    # remote has (the whole push, not just the tip), or the empty tree for a root commit.
    if ! unpushed="$(git rev-list --reverse "$local_sha" --not --remotes 2>&1)"; then
      echo "[codacy] push blocked: cannot list the commits no remote has ($unpushed) (fail closed)" >&2
      exit 1
    fi
    oldest="$(printf '%s\n' "$unpushed" | head -n 1)"
    if [[ -z "$oldest" ]]; then
      base="$local_sha"
    elif git rev-parse --verify -q "$oldest^" >/dev/null 2>&1; then
      base="$oldest^"
    else
      base="$EMPTY_TREE"
    fi
  else
    base="$remote_sha"
  fi
  if ! changed="$(git -c core.quotePath=false diff --name-only --diff-filter=ACMR "$base" "$local_sha" 2>&1)"; then
    echo "[codacy] cannot list changed files ($base..$local_sha): $changed" >&2
    echo "[codacy] push blocked (fail closed). Fix the git state, or override this gate only: CODACY_GATE_OFF=1 git push" >&2
    exit 1
  fi
  while IFS= read -r f; do
    [[ -n "$f" ]] && FILES["$f"]=1 && FILE_SHA["$f"]="$local_sha"
  done <<< "$changed"
done

[[ ${#FILES[@]} -gt 0 ]] || exit 0

CHANGED=()
for f in "${!FILES[@]}"; do
  is_analysis_file "$f" && CHANGED+=("$f")
done
[[ ${#CHANGED[@]} -gt 0 ]] || exit 0

# The gate reads working-tree files. Block when one differs from the commit it is
# pushed from, so the analysis never passes content the push does not contain.
UNCOMMITTED=()
for f in "${CHANGED[@]}"; do
  git diff --quiet "${FILE_SHA[$f]}" -- "$f" || UNCOMMITTED+=("$f")
done
if [[ ${#UNCOMMITTED[@]} -gt 0 ]]; then
  echo "[codacy] push blocked: these files differ from the commit being pushed, so the analysis would check content the push does not contain:" >&2
  printf '[codacy]   %s\n' "${UNCOMMITTED[@]}" >&2
  echo "[codacy]   fix: commit the changes, or set the unstaged changes aside with: git stash --keep-index" >&2
  exit 1
fi

echo "[codacy] analyzing ${#CHANGED[@]} changed file(s) ..."
node "$ROOT/scripts/codacy/pre-push-gate.mjs" --hook=pre-push "$ROOT" "${CHANGED[@]}"
status=$?
if [[ $status -ne 0 ]]; then
  echo "[codacy] push blocked by Codacy gate (fail closed): fix the findings or tooling error above." >&2
  echo "[codacy]   override this gate only: CODACY_GATE_OFF=1 git push" >&2
fi
exit $status
